# 国内镜像；并且强制直连，不让请求绕到用户级 C:\Users\<you>\.npmrc 里配的
# 127.0.0.1:10809 代理去（镜像本身在国内，直连更快，也不会在并发下载时被本地
# 代理卡死）。如果你所在网络必须走代理才能出网，删掉下面 proxy / https-proxy 两行。
registry=https://registry.npmmirror.com
proxy=false
https-proxy=false

# lockfile 里的 resolved 写的是 registry.npmjs.org，确保下载时替换成本项目配置的
# registry（npm 默认值 npmjs 只替换 npmjs.org 的 host，这里显式写死更稳妥）。
replace-registry-host=always
