HTTP_ADDR=:8080
DB_PATH=data/stock-x.db
START_DATE=2024-01-01
# 为空则不推送
FEISHU_WEBHOOK_URL=
# 交易日收盘后：增量同步 + 选股
CRON_SPEC=15 19 * * 1-5
BAOSTOCK_WORKERS=4
# 服务启动后后台增量同步期货 K 线到本地库，扫描优先读内存。0 = 关闭
FUTURES_SYNC=1
FUTURES_SYNC_EVERY=30m
FUTURES_SYNC_PERIODS=1d,5,15,30,60,120
FUTURES_SYNC_WORKERS=4
# 本地 1 分钟补得比某个分钟周期更深之后，该周期改由本地 1 分钟合成，不再问上游要。0 = 全部照旧走网络
FUTURES_SYNC_DERIVE=1
# 期货新闻：后台定时抓取。0 = 关闭
FUTURES_NEWS=1
FUTURES_NEWS_EVERY=5m
# 新闻源（逗号分隔）：eastmoney=东财 7x24 快讯，sina=新浪 7x24 快讯，emnews=东财资讯栏目
FUTURES_NEWS_SOURCES=eastmoney,sina
FUTURES_NEWS_LIMIT=200
# 东财快讯栏目号（102 = 国际财经，商品/期货快讯较多）
FUTURES_NEWS_EM_COLUMN=102
